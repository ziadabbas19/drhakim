NODE_ENV=development
PORT=5000

# Comma-separated list of frontend origins allowed to call the API
CLIENT_ORIGIN=http://localhost:5173

# Number of reverse proxies in front of the API in production (0 when running locally)
TRUST_PROXY=0

# Requests allowed per IP address every 15 minutes across the whole API
API_RATE_LIMIT_PER_15_MIN=600

# Successful public bookings allowed per IP address per hour
BOOKING_RATE_LIMIT_PER_HOUR=10

# Patient reviews are published only after the owner approves them in the dashboard.
# Successful review submissions allowed per IP address per day
REVIEW_RATE_LIMIT_PER_DAY=3
# Most reviews that may wait for approval at once; new submissions are politely refused above it
REVIEW_PENDING_CAP=200

# Database: set DATABASE_URL, or leave it empty and use the DB_* variables
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=dr_hakim
DB_USER=postgres
DB_PASSWORD=
DB_SSL=false
DB_LOGGING=false

# Use a long random string (at least 32 characters)
JWT_SECRET=replace-with-a-long-random-secret-of-at-least-32-characters
JWT_EXPIRES_IN=2h

# Owner accounts created by "npm run seed" (comma-separated).
# Each one must set a new password on first login.
OWNER_EMAILS=doctor@example.com,developer@example.com
OWNER_INITIAL_PASSWORD=ChangeMe@2026

# Image storage.
#   local:      files are kept in UPLOADS_DIR and served by the API at /uploads (development only:
#               most hosts wipe the disk on every deploy or restart).
#   cloudinary: files are stored on Cloudinary (production). Fill in the three CLOUDINARY_* values.
STORAGE_PROVIDER=local
UPLOADS_DIR=uploads
# Largest image accepted per file, in megabytes
MAX_UPLOAD_MB=5
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=dr-hakim

# Optional: database used by the automated tests. By default the tests use DB_NAME + "_test"
# (created automatically). The tests delete everything in it, and refuse to run on a database
# whose name does not end in "_test".
TEST_DATABASE_URL=
